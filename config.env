# ─────────────────────────────────────────────────────────────────────────────
# AI Stack — Centralized Version & URL Configuration
#
# This file is sourced by scripts/lib.sh and the Makefile.
# Change versions here instead of editing individual scripts.
# ─────────────────────────────────────────────────────────────────────────────

# ── NVIDIA / CUDA ────────────────────────────────────────────────────────────
CUDA_VERSION="12.4"
CUDA_KEYRING_VERSION="1.1-1"
NVIDIA_DRIVER_VERSION="550"

# ── Container images ─────────────────────────────────────────────────────────
CUDA_TEST_IMAGE="nvcr.io/nvidia/cuda:12.4.1-base-ubuntu22.04"

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_INSTALL_URL="https://ollama.com/install.sh"
OLLAMA_GITHUB_REPO="ollama/ollama"

# ── ComfyUI ──────────────────────────────────────────────────────────────────
COMFYUI_REPO="https://github.com/comfyanonymous/ComfyUI.git"
COMFYUI_INSTALL_DIR="/opt/ComfyUI"

# ── vLLM ─────────────────────────────────────────────────────────────────────
VLLM_PIP_PACKAGE="vllm"

# ── Authelia (MFA) ───────────────────────────────────────────────────────────
AUTHELIA_IMAGE="authelia/authelia:4"
AUTHELIA_PORT="9091"

# ── Ports (bare-metal) ──────────────────────────────────────────────────────
OLLAMA_PORT="11434"
VLLM_PORT="8000"
COMFYUI_PORT="8188"
