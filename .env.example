# ─────────────────────────────────────────────────────────────────────────────
# AI Stack — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Stack ────────────────────────────────────────────────────────────────────
# Port Nginx listens on (the single URL you open in your browser)
HOST_PORT=80

# ── Security ─────────────────────────────────────────────────────────────────
# LiteLLM master key — used by Open WebUI to authenticate with LiteLLM.
# Change this. Any string starting with "sk-" works.
LITELLM_MASTER_KEY=sk-ai-stack-change-me

# Open WebUI secret key — used to sign sessions. Change this.
WEBUI_SECRET_KEY=change-me-in-production

# Require login for Open WebUI (true = users must log in)
WEBUI_AUTH=true

# ── Default Admin Account (created on first boot) ────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@local.host
DEFAULT_ADMIN_PASSWORD=changeme
WEBUI_DEFAULT_USER_ROLE=user

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=litellm_pass

# ── Image tags ───────────────────────────────────────────────────────────────
OPEN_WEBUI_TAG=main
LITELLM_TAG=main-latest
OLLAMA_TAG=latest
# COMFYUI_TAG is an ARG in the Dockerfile (git tag / branch)
COMFYUI_TAG=latest

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Only fill in the keys for providers you actually use.
# Unused keys can be left blank or removed.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GOOGLE_API_KEY=

# ── Ollama (local models) ─────────────────────────────────────────────────────
# Leave blank to use the built-in sidecar container (started with --profile ollama).
# Set to an external URL if you run Ollama on the host or another machine.
OLLAMA_BASE_URL=http://ollama:11434

# ── ComfyUI launch args ───────────────────────────────────────────────────────
# Additional flags passed to ComfyUI's main.py
# CPU-only (default):
COMFYUI_ARGS=--listen 0.0.0.0 --port 8188
# NVIDIA GPU (use with docker-compose.gpu.yml):
# COMFYUI_ARGS=--listen 0.0.0.0 --port 8188 --gpu-only
# GH200 / Hopper BF16 (use with docker-compose.gh200.yml):
# COMFYUI_ARGS=--listen 0.0.0.0 --port 8188 --bf16-unet --bf16-vae

# ── vLLM (high-throughput local inference) ────────────────────────────────────
# HuggingFace model ID to load in vLLM. Must accept the model license on HF first.
VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.85
# HuggingFace token — required for gated models (Llama, FLUX, etc.)
HF_TOKEN=

# ── MFA / Authelia ───────────────────────────────────────────────────────────
# Generated automatically by scripts/setup-mfa.sh — leave blank to auto-generate
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_ENCRYPTION_KEY=
# Authelia container image
AUTHELIA_IMAGE=authelia/authelia:4

# ── HTTPS / Let's Encrypt ─────────────────────────────────────────────────────
# Set after running scripts/setup-ssl.sh
DOMAIN=
